# Copy to backend/.env; never commit real credentials.
# One-time authorization: python3 scripts/setup_gmail.py --help
MAIL_PROVIDER=gmail_api
PASSWORD_RESET_ENABLED=true
MAIL_FROM=your-project-sender@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
FRONTEND_URL=http://localhost:5173
# Uses HTTPS. A Gmail password or App Password will not work here.
# The same sender handles invitations requested by the operator, admins or project managers.
# PASSWORD_RESET_ENABLED controls recovery; invitations have their own send checkbox.
# Private operator setup: python3 backend/scripts/provision_company.py --configure (from project root).
# Keep this key out of frontend configuration. An empty key disables company provisioning.
COMPANY_PROVISIONING_KEY=
