# Reference only: put real values in hosting secret fields. This file does not deploy.
SPRING_PROFILES_ACTIVE=prod
MAIL_PROVIDER=gmail_api
MAIL_FROM=your-project-sender@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
FRONTEND_URL=https://your-frontend.example.com
JWT_SECRET=
# Base64-encoded random 32-byte key; keep stable to decrypt existing GitHub tokens.
TOKEN_ENCRYPTION_KEY=
# Same random secret (at least 32 characters) on backend and AI service.
AI_SERVICE_TOKEN=
AI_SERVICE_URL=https://your-ai-service.example.com
SPRING_DATASOURCE_URL=jdbc:postgresql://your-database-host:5432/your-database?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# Fresh schema: use psql with database/init.sql and its adjacent migrations directory.
# Existing schema: back up, stop the backend, then apply pending migrations in order.
# See docs/team-workflow.md for role migration and invitation setup.
# OAuth Testing refresh tokens expire after 7 days; see docs/gmail-api-setup.md.

# Private operator provisioning; empty disables it. Never expose in frontend settings.
COMPANY_PROVISIONING_KEY=
